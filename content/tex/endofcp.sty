% ============================================================================
%  endofcp.sty
%  Styles for the ICPC team reference document.
%
%  No Python is required: the upstream pdflatex -shell-escape preprocessor
%  hook has been removed.
%
%  Contents
%    1. Dependencies
%    2. Document metadata      \team \university \contest \subtitle
%    3. Cover pages            \maketitle \maketeampage
%    4. Running header/footer
%    5. Heading styles         chapter / section / sub
%    6. Table of contents
%    7. Colours
%    8. Special glyphs
%    9. Code listings
%   10. Listing captions
%   11. Content inclusion      \eocpcontentdir \eocpchapter
%   12. Utilities
% ============================================================================
\ProvidesPackage{endofcp}

% ============================================================================
%  1. Dependencies
% ============================================================================
\usepackage{fontspec}                     % TTF/OTF fonts (LuaLaTeX)
\usepackage{listings}                     % Source code listings
\usepackage{framed}                       % Listings frames
\usepackage[a4paper,landscape,hmargin={0.5cm,0.5cm},vmargin={1.0cm,0.4cm}]{geometry} % A4 landscape
\usepackage{multicol}                     % Multi-column pages
\usepackage{fancyhdr}                     % Running headers/footers
\usepackage{amsbsy, amssymb, amsmath}     % Math symbols
\usepackage{tocloft}                      % Table of contents (global layout)
\usepackage{titletoc}                     % Table of contents (local entries)
\usepackage{ifthen}                       % Conditionals
% \usepackage{courier}                    % replaced by fontspec mono font
\usepackage{graphicx}                     % \includegraphics, \scalebox
% \usepackage{fix-cm}                     % not needed with fontspec
\usepackage{paralist}                     % Compact lists
\usepackage[inline]{enumitem}             % Inline lists
\usepackage[parfill]{parskip}             % Paragraph spacing
\usepackage[dvipsnames]{xcolor}           % Colours
\usepackage[normalem]{ulem}               % \uline and friends
\usepackage[hidelinks]{hyperref}          % Clickable table of contents

% ---- Fonts (TTF files in ./fonts) ----
% Body text + code: Source Code Pro.  Headings: Lora.
\setmainfont{SourceCodePro}[
  Path=fonts/, Extension=.ttf,
  UprightFont=SourceCodePro-regular, BoldFont=SourceCodePro-bold,
  ItalicFont=SourceCodePro-italic, BoldItalicFont=SourceCodePro-boldItalic]
\setmonofont{SourceCodePro}[
  Path=fonts/, Extension=.ttf,
  UprightFont=SourceCodePro-regular, BoldFont=SourceCodePro-bold,
  ItalicFont=SourceCodePro-italic, BoldItalicFont=SourceCodePro-boldItalic]
\newfontfamily\lorafont{Lora}[
  Path=fonts/, Extension=.ttf,
  UprightFont=Lora-regular, BoldFont=Lora-bold,
  ItalicFont=Lora-italic, BoldItalicFont=Lora-boldItalic]
% ============================================================================
%  2. Document metadata   (call these in the main .tex, before \begin{document})
% ============================================================================
\newcommand{\subtitle}[1]{\def\@subtitle{#1}}
\newcommand{\team}[2]{\def\@teamname{#1}\def\@teammembers{#2}}
\newcommand{\contest}[2]{\def\@contestname{#1}\def\@contestdate{#2}}
\newcommand{\university}[3]{\def\@unishort{#1}\def\@unilong{#2}\def\@unilogo{#3}}

% default title (override with \title etc. if wanted)
\subtitle{}
\title{EndofCP}
\def\@builddir{build}

% \today as YYYY-MM-DD
\def\today{\number\year-\ifthenelse{\number\month<10}{0}{}\number\month-\ifthenelse{\number\day<10}{0}{}\number\day}

% ============================================================================
%  3. Cover pages
% ============================================================================
\renewcommand{\maketitle}[2]{%
  \begin{center}
    {\Huge \@title}\\
    {\huge \@subtitle{} version #2}\\[0.1cm]
    {\Huge \textsc{#1}}
  \end{center}
}

% Full-page cover: university, team, and members. A logo and date are omitted.
\newcommand{\maketeampage}{%
  \pagestyle{empty}
  \setcounter{page}{0}
  \begin{center}
    \strut % magic
    \vspace{5cm}\\
    {\lorafont\fontsize{25}{30}\selectfont \@unilong\\}
    {\lorafont\fontsize{60}{60}\selectfont \@teamname\\}
    \vspace{0.5cm}
    {\lorafont\huge \@teammembers\\}
    \vfill
    \vspace{1cm}
  \end{center}
  \clearpage
  \pagestyle{fancy}
}

% ============================================================================
%  4. Running header / footer
% ============================================================================
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0pt}
\headheight 25pt
\lhead{\@teamname{} \quad \@unilong}   % left  : team name, then university
\chead{}                                % centre: empty
\rhead{\thepage}                        % right : page number (top right)
\lfoot{}\cfoot{}\rfoot{}
\fancyheadoffset{0pt}
\fancyfootoffset{0pt}
\setlength\headsep{5pt}

% Chapters default to the 'plain' page style (no header) on their first page;
% make 'plain' behave like 'fancy' so the header shows there too.
\let\ps@plain\ps@fancy

% eTeX mark used by the (unused) per-page file list
\newmarks\hdrmark

% ============================================================================
%  5. Heading styles
% ----------------------------------------------------------------------------
%  Level   Native command      Look
%  -----   --------------      ------------------------------------------
%   H1     \chapter             huge, bold, UNDERLINED, numbered "(n)"
%   H3     \section             LARGE, bold, no underline, numbered "1.2"
%   H5     \subHeading          small bold + full-column rule
%
%  Named wrappers for the .tex files:
%     \chapterHeading{...}  -> H1  (chapter  + underline)
%     \sectionHeading{...}  -> H3  (section, no underline)
%     \subHeading{...}      -> H5  (small bold + full-column rule)
%
%  These are the only three heading levels used; \subsection and
%  \subsubsection are aliased to \subHeading below.
% ============================================================================
\renewcommand\chapter{%
  \global\@topnum\z@
  \secdef \@chapter \@schapter
}

% ---- H1: chapter title (underlined) ---------------------------------------
\def\@makechapterhead#1{%
  \parindent \z@ \raggedright \normalfont
  \interlinepenalty\@M
  {\lorafont\underline{\huge \bfseries #1} }              % underlined title
  \ifnum \c@secnumdepth >\m@ne
    {\lorafont\huge\bfseries (\thechapter) \par\nobreak } % "(n)" chapter number
  \fi
  \startcontents[chapters]
}

% ---- H3: section (no underline) -------------------------------------------
% parskip.sty subtracts its (rubber) \parskip from these skips; since they are
% smaller than \parskip the afterskip went negative and multicols then stretched
% it unevenly. Adding \parskip back makes the net afterskip a rigid value.
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-0.5ex \@plus -1ex \@minus -.2ex}%
  {\dimexpr\parskip+.0ex\relax \@plus 2pt \@minus 0pt}%
  {\lorafont\LARGE\bfseries}}

% ---- Named heading commands -----------------------------------------------
\newcommand{\chapterHeading}[1]{\chapter{#1}}   % H1
\newcommand{\sectionHeading}[1]{\section{#1}}   % H3
\newcommand{\subHeading}[1]{%                   % bold + full-column rule
  \par\vspace{1pt}\noindent
  \vbox{%
    \hbox to\linewidth{\lorafont\bfseries #1\hfil}%
    \kern2pt
    \hrule width\linewidth height0.4pt
  }\par\nobreak
  \vspace{.5pt}%
}
\let\subsection\subHeading                      % no separate 4th/5th level
\let\subsubsection\subHeading

% ============================================================================
%  6. Table of contents
% ============================================================================
% Local (per-chapter) entries
\titlecontents{localsection}[1.5em]{\small}{}{\small}{\titlerule*[0.8em]{.}\contentspage}
\titlecontents{localsubsection}[3.8em]{\small}{}{\small}{\titlerule*[0.8em]{.}\contentspage}

% Main TOC
\renewcommand{\chaptermark}[1]{\markboth{\emph{ #1}}{}}
\renewcommand{\cftbeforetoctitleskip}{-45pt}
\renewcommand{\cftaftertoctitleskip}{10pt}
\renewcommand{\cftbeforechapskip}{11pt}
\renewcommand\cftchapfont{\large\bfseries}
\renewcommand{\cftdotsep}{4.5}
\setcounter{tocdepth}{1}

% Appendices: lettered A, B, C, ... and kept out of the global TOC
\newboolean{appendixmode}
\setboolean{appendixmode}{false}
\let\Oldaddtoc\addcontentsline
\renewcommand{\addcontentsline}[3]{%
  \ifthenelse{\boolean{appendixmode}\and\equal{#1}{toc}}{}{\Oldaddtoc{#1}{#2}{#3}}%
}
\renewcommand\appendix{%
  \setcounter{tocdepth}{8}
  \setcounter{chapter}{0}
  \def\thechapter{\Alph{chapter}}
  \setboolean{appendixmode}{true}
  \clearpage
}

% ============================================================================
%  7. Colours   (see also \enablecolors in section 9)
% ============================================================================
\definecolor{mygreen}{HTML}{007000}
\definecolor{myblue}{HTML}{0000dd}

% ============================================================================
%  8. Special glyphs   (used by the listings 'literate' map in section 9)
% ============================================================================
\newcommand*{\caret}{%
  \begingroup
    \ttfamily
    \selectfont
    \string^%
  \endgroup
}
\newcommand*{\lsttilde}{\raise.17ex\hbox{$\scriptstyle\sim$}}

% Fatter braces, easier to tell apart from parentheses
\newcommand*{\nicelbrace}{%
  \begingroup
    \ttfamily
    \selectfont
    \scalebox{1.5}[1]{\color{black!80}{\{}}%
  \endgroup
}
\newcommand*{\nicerbrace}{%
  \begingroup
    \ttfamily
    \selectfont
    \scalebox{1.5}[1]{\color{black!80}{\}}}%
  \endgroup
}

% ============================================================================
%  9. Code listings
% ============================================================================
\lstset{language=C++}
\lstset{morekeywords={alignas,alignof}}
\lstset{deletedirectives={line}}
\lstset{frame=none}              % no rule around code blocks; the only rule is \subHeading's
\lstset{tabsize=2}
\lstset{showstringspaces=false}
\lstset{breaklines=true}
\lstset{basicstyle=\normalsize\ttfamily}
\lstset{commentstyle=\ttfamily\upshape}
\lstset{keywordstyle=\ttfamily\upshape\mdseries}
\lstset{escapeinside={(*}{*)}}            % (*\strong{word}*) -> LaTeX/bold inside code
\lstset{literate={^}{\caret}{1} {~}{\lsttilde}{1} {\{}{\nicelbrace}{1} {\}}{\nicerbrace}{1}}
\lstset{emptylines=*1}
\lstset{inputencoding=utf8}
\lstset{aboveskip=3pt}           % vertical space above a block
\lstset{belowskip=2pt}           % vertical space below a block

\lstdefinelanguage{raw}{}        % raw language: no keywords

% Opt-in coloured code (\enablecolors in the main .tex)
\newcommand{\enablecolors}{
  \lstset{basicstyle=\footnotesize\ttfamily\color{mygreen}}
  \lstset{commentstyle=\color{darkgray}\normalfont\itshape}
  \lstset{keywordstyle=\color{myblue}}
  \lstset{identifierstyle=\color{black}}
}

% ============================================================================
% 10. Listing captions   (Description / Usage / Memory / Time)
%     Only used by \eocpimport, i.e. the upstream code preprocessor path.
% ============================================================================
\newboolean{hasleftcaption}
\newcommand{\leftcaption}[1]{\def\@leftcaption{#1}\setboolean{hasleftcaption}{true}}
\leftcaption{}
\setboolean{hasleftcaption}{false}

\newcommand{\rightcaption}[1]{\def\@rightcaption{#1}}
\rightcaption{}

\newboolean{hasdescription}
\newcommand{\defdescription}[1]{\def\@defdescription{#1}\setboolean{hasdescription}{true}}
\defdescription{}
\setboolean{hasdescription}{false}

\newboolean{hasusage}
\newcommand{\defusage}[1]{\def\@defusage{\texttt{#1}}\setboolean{hasusage}{true}}
\defusage{}
\setboolean{hasusage}{false}

\newboolean{hastime}
\newcommand{\deftime}[1]{\def\@deftime{#1}\setboolean{hastime}{true}}
\deftime{}
\setboolean{hastime}{false}

\newboolean{hasmemory}
\newcommand{\defmemory}[1]{\def\@defmemory{#1}\setboolean{hasmemory}{true}}
\defmemory{}
\setboolean{hasmemory}{false}

\newcommand{\codeheader}[2]{{\par\noindent\footnotesize{\strong{#1:} #2\par}}}

\long\def\@makecaption#1#2{%
  \vspace{-3pt}
  \ifthenelse{\boolean{hasdescription}}{\codeheader{Description}{\@defdescription}}{}
  \ifthenelse{\boolean{hasusage}}{\codeheader{Usage}{\@defusage}}{}
  \ifthenelse{\boolean{hasmemory}}{\codeheader{Memory}{\@defmemory}}{}
  \ifthenelse{\boolean{hastime}}{\codeheader{Time}{\@deftime}}{}
  \ifthenelse{\boolean{hasleftcaption}}{\vspace{0pt}}{\vspace{-5pt}}
  \tiny
  \texttt{\@leftcaption} \hfill \@rightcaption
}

% ============================================================================
% 11. Content inclusion
% ============================================================================
% Where chapter folders live; \eocpchapter{name} reads <dir>/name/chapter.tex
\newcommand{\eocpcontentdir}[1]{\def\@eocpbasedir{#1}\def\@eocpdir{#1}}
\eocpcontentdir{.}

\newcommand{\eocpchapter}[1]{%
  \def\@eocpdir{\@eocpbasedir/#1}%
  \input{"\@eocpdir/chapter.tex"}%
  \def\@eocpdir{\@eocpbasedir}%
}

\newcommand{\import}[1]{\input{"\@eocpdir/#1"}}

% --- upstream preprocessor path (kept for reference; needs Python) ----------
\newcommand{\eocpref}[1]{%
  \ifthenelse{\boolean{appendixmode}}{}{%
    \ifnum \value{section} > 0
      \addcontentsline{ptc}{subsection}{\texttt{#1}\hspace{0.2em}}%
    \else
      \addcontentsline{ptc}{section}{\texttt{#1}\hspace{0.2em}}%
    \fi
  }%
  \marks\hdrmark{#1}%
}

% Like \needspace, but with flush bottoms
\newcommand{\myneedspace}[1]{%
  \begingroup
    \setlength{\dimen@}{#1}%
    \vskip\dimen@
    \penalty 9999%
    \vskip -\dimen@
    \vskip\z@skip
  \endgroup
}

\newcommand{\eocpimport}[2][]{%
  \leftcaption{}\rightcaption{}
  \setboolean{hasdescription}{false}
  \setboolean{hasusage}{false}
  \setboolean{hastime}{false}
  \setboolean{hasmemory}{false}
  \setboolean{hasleftcaption}{false}
  \myneedspace{3\baselineskip}
  \penalty-100
  {\large #2}
  \immediate\write18{rm -f \@builddir/eocp.tmp}
  \immediate\write18{python3 content/tex/preprocessor.py -i "\@eocpdir/#2" -o \@builddir/eocp.tmp #1}
  \immediate\input{\@builddir/eocp.tmp}
}

\newcommand{\eocperror}[1]{\PackageError{eocp}{#1}{}}
\newcommand{\eocpwarning}[1]{\PackageWarning{eocp}{#1}}

